{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://status-api.exploit-db.xyz/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://status-api.exploit-db.xyz/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
