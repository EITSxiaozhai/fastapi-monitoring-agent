# 复制为 .env 并按需修改

# ---------- 数据库连接 ----------
# 后端最终使用的连接串为：
#   postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
#
# 用 docker compose 自带的 db 服务时：DB_HOST 保持 db（compose 服务名），
# 只需按需改用户名/密码/库名即可。
# 连接“外部/已有的数据库”时：把 DB_HOST 改成该库的 IP 或域名，端口/账号相应填写，
# 此时可不启动内置 db 服务（docker compose up server web agent）。
DB_HOST=db
DB_PORT=5432
DB_USER=mon
DB_PASSWORD=mon
DB_NAME=mon

# 客户端上报鉴权用的 API Key（管理端与客户端需一致；生产务必修改）
API_KEY=changeme-dev-key

# 管理端登录账号（前端登录使用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT 签名密钥（生产务必修改为随机长字符串）
JWT_SECRET=change-me-in-production-please

# Cloudflare Turnstile 人机验证（可选）
# sitekey 前端公开使用；secret 留空则后端不校验（便于本地开发）
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# ---------- 客户端外网 IP / 国家查询（可选，作用于 agent 容器） ----------
# 客户端会查询自身公网出口 IP 及所属国家，用于在卡片右上角显示国旗。
# GEOIP_DISABLE=1     # 置 1 完全关闭外网 IP 查询
# GEOIP_TTL=1800      # 缓存有效期（秒），公网 IP 很少变动
# GEOIP_ENDPOINT=http://ip-api.com/json/?fields=status,message,query,countryCode,country
