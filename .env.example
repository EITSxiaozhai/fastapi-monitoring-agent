# 复制为 .env 并按需修改

# 数据库密码
DB_PASSWORD=mon

# 客户端上报鉴权用的 API Key（管理端与客户端需一致；生产务必修改）
API_KEY=changeme-dev-key

# 管理端登录账号（前端登录使用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT 签名密钥（生产务必修改为随机长字符串）
JWT_SECRET=change-me-in-production-please

# Cloudflare Turnstile 人机验证（可选）
# sitekey 前端公开使用；secret 留空则后端不校验（便于本地开发）
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
